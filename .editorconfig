# Keeps indentation and line endings consistent across editors.
# VS Code needs the EditorConfig extension to pick this up (see .vscode/extensions.json).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses trailing spaces for hard line breaks, so leave them alone.
trim_trailing_whitespace = false

[*.{yml,yaml,toml,json}]
indent_size = 2
